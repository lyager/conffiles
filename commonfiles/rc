# fi
export DEBFULLNAME="Jesper L. Nielsen"
export EDITOR="$(if command -v nvim >/dev/null 2>&1; then echo nvim; else echo vi; fi)"
export PYTHONPATH=/opt/lib/python/
export GEM_PATH=~/gems/
export GEM_HOME=~/gems/
export PATH="$(python3 -m site --user-base)/bin:$PATH" # Python
export PATH=~/gems/bin:$PATH   # Ruby
export PATH=~/node/bin:$PATH   # NodeJS
export PATH=~/go/bin:$PATH     # Go
export PATH=$(yarn global bin 2> /dev/null):$PATH     # Yarn
export PATH=~/bin:/usr/local/bin:/usr/local/sbin/:/usr/sbin:/sbin:$PATH
[ -d /opt/homebrew/opt/node@24/bin ] && export PATH="/opt/homebrew/opt/node@24/bin:$PATH"
#export PATH="/opt/homebrew/opt/node@22/bin:$PATH"
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"            # Rust
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"    # uv
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# Start or reuse an ssh-agent. Linux only: on macOS launchd provides one.
if [ "$(uname)" = Linux ]; then
    if ! pgrep -u "$USER" ssh-agent > /dev/null; then
        eval "$(ssh-agent -s)"
    else
        export SSH_AGENT_PID=$(pgrep -u "$USER" ssh-agent | head -n 1)
        export SSH_AUTH_SOCK=$(find /tmp -type s -user "$USER" -name 'agent.*' 2>/dev/null | head -n 1)
    fi
fi

# The below encoding is important for tab completion with
# oh-my-zsh. Trying to put in in the general RC file, if this 
# complains under bash, move it to .zshrc
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

alias sshi='ssh -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no'
alias scpi='scp -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no'

# Computer specific settings, last so they can override anything above.
if [ -e ~/.rc.local ] ; then
    . ~/.rc.local
fi
